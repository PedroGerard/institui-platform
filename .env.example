# INSTITUI+ monorepo
# Copie para .env somente em ambiente local. Nunca versionar segredos reais.

NODE_ENV=development
DATABASE_URL="postgresql://institui:institui@localhost:5432/institui"

# API
PORT=3333
HOST=0.0.0.0
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
CORS_METHODS="GET,POST,PATCH,DELETE,OPTIONS"
CORS_HEADERS="Content-Type,Authorization,x-association-id,x-user-id"

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:3333"
NEXT_PUBLIC_ACTIVE_ASSOCIATION_ID=""
